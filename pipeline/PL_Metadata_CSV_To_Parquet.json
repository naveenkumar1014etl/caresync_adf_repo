{
	"name": "PL_Metadata_CSV_To_Parquet",
	"properties": {
		"activities": [
			{
				"name": "LK_Get_Active_Sources",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Ingestion_Config_JSON",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLT_Active_Sources",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LK_Get_Active_Sources",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LK_Get_Active_Sources').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(\n    equals(item().is_active, true),\n    equals(item().load_group, 'INCREMENTAL')\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FE_Process_Active_Sources",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FLT_Active_Sources",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FLT_Active_Sources').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "EP_Copy_Current_Source",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Copy_CSV_To_Parquet",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"pSourceDirectory": {
										"value": "@item().source_directory",
										"type": "Expression"
									},
									"pSourceFileName": {
										"value": "@item().source_file_name",
										"type": "Expression"
									},
									"pSinkDirectory": {
										"value": "@item().sink_directory",
										"type": "Expression"
									},
									"pSinkFileName": {
										"value": "@item().sink_file_name",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "GM_Discover_Day3_File",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_CSV_Source",
						"type": "DatasetReference"
					},
					"fieldList": [],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"annotations": []
	}
}